APP_ENV=development
APP_DEBUG=true
APP_CORS_ORIGINS=http://localhost:3000,http://localhost:8081
APP_ALLOWED_HOSTS=127.0.0.1,localhost,testserver
APP_RATE_LIMIT_PER_MINUTE=120

GEMINI_API_KEY=
