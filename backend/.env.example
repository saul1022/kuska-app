GOOGLE_API_KEY=
INCIDENT_PROCESSOR=mock
GEMINI_MODEL=gemma-4-31b-it
GEMINI_REVIEW_THRESHOLD=0.60

# Se usarán en la siguiente integración con Supabase.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_STORAGE_BUCKET=incident-evidence
